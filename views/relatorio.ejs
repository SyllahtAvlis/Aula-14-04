<!DOCTYPE html>
<html>
<head>
    <title>Relatório de Produtos</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.5.3/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
</head>

<body>
    <div class="container mt-4">
        <h1 class="text-center mb-4">Relatório de Produtos</h1>

        <button type="button" class="btn btn-primary mb-3" data-toggle="modal" data-target="#filtroPrecoModal">
            Gerar PDF
        </button>

        <table class="table table-bordered table-striped">
            <thead class="thead-dark">
                <tr>
                    <th>ID</th>
                    <th>NOME</th>
                    <th>DESCRIÇÃO</th>
                    <th>FORNECEDOR</th>
                    <th>MARCA</th>
                    <th>PREÇO COMPRA</th>
                    <th>PREÇO VENDA</th>
                    <th>ESTOQUE</th>
                </tr>
            </thead>
            <tbody>
                <% products.forEach(dado => { %>
                    <tr>
                        <td><%= dado.ID %></td>
                        <td><%= dado.nome %></td>
                        <td><%= dado.descricao %></td>
                        <td><%= dado.fornecedor %></td>
                        <td><%= dado.marca %></td>
                        <td><%= dado.precocompra %></td>
                        <td><%= dado.precovenda %></td>
                        <td><%= dado.estoque %></td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
        <div class="text-right mt-4">
            <p class="text-muted">Página 1</p>
            <p class="text-muted">Gerado em: <%= new Date().toLocaleDateString() %></p>
        </div>
    </div>

    <div class="modal fade" id="filtroPrecoModal" tabindex="-1" role="dialog" aria-labelledby="filtroPrecoModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-body">
                    <form action="/relatorio/pdf" method="get">
                        <button type="submit" class="btn btn-primary">Gerar PDF</button>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Fechar</button>
                </div>
            </div>
        </div>
    </div>

</body>
</html>
